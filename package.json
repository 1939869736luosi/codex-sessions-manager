{
  "name": "codex-sessions-manager",
  "version": "0.8.1",
  "description": "Verify official Codex deletion, audit local residue, and perform recoverable legacy or orphan cleanup via CLI and bounded MCP tools.",
  "type": "module",
  "bin": {
    "codex-sessions": "dist/cli/index.js",
    "codex-sessions-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/SAFETY.md",
    "docs/SKILL_DETAIL.md",
    "docs/UNKNOWN_GLOBAL_STATE_RULES.md",
    "SKILL.md",
    "skills/codex-sessions-manager",
    "adapters",
    "agents/openai.yaml",
    "examples/codex-sessions-manager.SKILL.md",
    "LICENSE"
  ],
  "keywords": [
    "codex",
    "openai",
    "session",
    "cli",
    "mcp",
    "cleanup",
    "delete",
    "management"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1939869736luosi/codex-sessions-manager.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "cli": "node dist/cli/index.js",
    "mcp": "node dist/mcp/server.js",
    "compat:check": "node scripts/check-compat.mjs",
    "compat:release-check": "node scripts/check-compat.mjs --release",
    "smoke:release": "node scripts/smoke-release.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test-coverage.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
